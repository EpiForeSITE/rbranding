# R Files
^.*\.Rproj$
^\.Rproj\.user$
^\.\.Rcheck$

# Git and Dev Files
^\.github$
^\.git\*$
^\.vscode$
^\.devcontainer$
^playground$

# Other files to ignore
^LICENSE\.md$
^Makefile$
^run_app\.sh$

## Branding Files
^_brand\.yml$
^bak_brand\.yml$
^config\.yml$
^rbranding_config\.yml$
^icon\.png$
^logo\.png$

^[.].*$
^.*/[.].*$

# Articles
^vignettes/accessibility\.qmd$
^vignettes/.*_files$
^vignettes/\.quarto$

# Resources
^resources$

# Website
^docs$
^_pkgdown\.yml$
^pkgdown$

^README\.qmd$
^foresite_themes$
^foresite_logos_and_materials$
^cran-comments\.md$
